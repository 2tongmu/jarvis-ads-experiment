; Top Design: "spdt_switch_pdk_lib:lpf_demo:schematic"
; Netlisted using Hierarchy Policy: "Standard"

Options ResourceUsage=yes UseNutmegFormat=no EnableOptim=no TopDesignName="spdt_switch_pdk_lib:lpf_demo:schematic" DcopOutputNodeVoltages=yes DcopOutputPinCurrents=yes DcopOutputAllSweepPoints=no DcopOutputDcopType=0
Port:Term1  N__1 0 Num=1 Z=50 Ohm Noise=yes 
L:L1  N__1 N__5 L=7.958 nH Noise=yes  
C:C1  N__5 0 C=6.366 pF 
L:L2  N__5 N__7 L=7.958 nH Noise=yes  
Port:Term2  N__7 0 Num=2 Z=50 Ohm Noise=yes 
S_Param:SP1 CalcS=yes CalcY=no CalcZ=no GroupDelayAperture=1e-4 FreqConversion=no FreqConversionPort=1 StatusLevel=2 CalcNoise=no SortNoise=0 BandwidthForNoise=1.0 Hz DevOpPtLevel=0 SPSS_WSP=yes \
SweepVar="freq" SweepPlan="SP1_stim" OutputPlan="SP1_Output" 

SweepPlan: SP1_stim Start=100 MHz Stop=5 GHz Step=100 MHz 

OutputPlan:SP1_Output \
      Type="Output" \
      UseEquationNestLevel=yes \
      EquationNestLevel=2 \
      UseSavedEquationNestLevel=yes \
